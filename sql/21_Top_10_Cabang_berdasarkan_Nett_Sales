SELECT
  branch_id,
  branch_name,
  kota,
  provinsi,
  COUNT(*) AS total_transaksi,
  SUM(nett_sales) AS total_nett_sales,
  SUM(nett_profit) AS total_nett_profit,
  AVG(rating_transaksi) AS rating_transaksi
FROM `finaltask-508502.kimia_farma.kf_analisa`
GROUP BY
  branch_id,
  branch_name,
  kota,
  provinsi
ORDER BY total_nett_sales DESC
LIMIT 10;
